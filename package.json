{
  "name": "full-stack-chatbot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate up --envPath .env --migration-file-language mjs",
    "migrate:down": "node-pg-migrate down --envPath .env --migration-file-language mjs",
    "start": "node src/server.js",
    "test": "node --check src/*.js && node --test test/*.test.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0"
  }
}
